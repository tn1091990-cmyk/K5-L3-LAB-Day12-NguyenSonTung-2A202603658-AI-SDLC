<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DaoDenLong.Headless</AssemblyName>
    <RootNamespace>DaoDenLong.Headless</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- The game core has no UnityEngine references on purpose: Unity's view layer and this runner
       compile the same files, so the numbers the graders measure are the numbers you play. -->
  <ItemGroup>
    <Compile Include="..\..\UnityProject\Assets\DaoDenLong\Core\*.cs" />
  </ItemGroup>

</Project>
